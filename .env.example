
# OpenAI — used for embeddings (text-embedding-3-small) and chat (gpt-4.1-mini)
OPENAI_API_KEY=

# Pinecone — vector store for the RAG index
PINECONE_API_KEY=

# Name of your Pinecone index (512-dim vectors, cosine similarity)
PINECONE_INDEX=employee-policy-helper
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
PINECONE_NAMESPACE=
INGESTION_REPORT=artifacts/ingestion-report.json

# Vector length used by ingestion and query embeddings.
EMBEDDING_DIMENSIONS=512

